<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_circle_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_circle"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Vinyl Disc Graphic with Center Play/Pause -->
    <FrameLayout
        android:layout_width="66dp"
        android:layout_height="66dp">

        <ImageView
            android:id="@+id/widget_circle_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:src="@drawable/widget_vinyl_disc" />

        <ImageButton
            android:id="@+id/btn_circle_center_play"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_btn_circle_accent"
            android:contentDescription="@string/play"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_play" />
    </FrameLayout>

    <!-- Track & Artist Info -->
    <TextView
        android:id="@+id/widget_circle_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_circle_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/music_player"
        android:textColor="#94A3B8"
        android:textSize="10sp" />

    <!-- Compact Controls: Rewind & Next -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_circle_rewind"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/rewind"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_rewind" />

        <ImageButton
            android:id="@+id/btn_circle_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/next"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_next" />
    </LinearLayout>

</LinearLayout>
