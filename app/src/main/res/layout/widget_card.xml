<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: Disc Art + Track Info + Status Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Vinyl Disc Icon -->
        <ImageView
            android:id="@+id/widget_card_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/widget_vinyl_disc" />

        <!-- Title, Artist, and Folder Info -->
        <LinearLayout
            android:id="@+id/widget_card_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_card_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="🎵 RitmoPlayer"
                android:textColor="#06B6D4"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_card_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/music_player"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Status indicator (e.g. "PLAY" / "PAUSA") -->
        <TextView
            android:id="@+id/widget_card_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2206B6D4"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="PAUSA"
            android:textColor="#06B6D4"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/widget_card_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_style" />

    <!-- Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Rewind / Double-tap Prev -->
        <ImageButton
            android:id="@+id/btn_card_rewind"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/rewind"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_rewind" />

        <!-- Play / Pause -->
        <ImageButton
            android:id="@+id/btn_card_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_circle_accent"
            android:contentDescription="@string/play"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_play" />

        <!-- Fast Forward (+10s) -->
        <ImageButton
            android:id="@+id/btn_card_fast_forward"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/fast_forward"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_fast_forward" />

        <!-- Next -->
        <ImageButton
            android:id="@+id/btn_card_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/next"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_next" />
    </LinearLayout>

</LinearLayout>
