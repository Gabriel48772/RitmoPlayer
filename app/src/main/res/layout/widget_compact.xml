<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_container"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/widget_bg_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <!-- Vinyl Disc Icon / App Art -->
    <ImageView
        android:id="@+id/widget_compact_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/widget_vinyl_disc" />

    <!-- Track & Artist Info -->
    <LinearLayout
        android:id="@+id/widget_compact_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_compact_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_compact_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/music_player"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Controls Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Rewind / Previous -->
        <ImageButton
            android:id="@+id/btn_compact_rewind"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/rewind"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_rewind" />

        <!-- Play / Pause -->
        <ImageButton
            android:id="@+id/btn_compact_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_btn_circle_accent"
            android:contentDescription="@string/play"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_play" />

        <!-- Next -->
        <ImageButton
            android:id="@+id/btn_compact_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/next"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_notif_next" />
    </LinearLayout>

</LinearLayout>
